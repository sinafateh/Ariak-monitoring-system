NODE_ENV=production
API_PORT=3001
WORKSPACE_KEY=monitoring-system
MONITORING_DATA_DIR=../monitoring-system-data
MONITORING_LOG_DIR=../monitoring-system-data/logs
# Demo fixtures are available only in the Vite development server and are read-only.
VITE_DEMO_MODE=false
# Show clearly labeled, non-persistent sample faults on selected test projects in Vite development.
VITE_DEMO_FAULTS=true
# Set a unique random value (at least 32 characters) for each installation.
# Losing this key makes saved panel passwords unrecoverable.
# PANEL_CREDENTIALS_KEY=

# PostgreSQL connection. Use a dedicated non-superuser application role.
# DATABASE_URL=postgresql://monitoring_runtime:CHANGE_ME@HOST:5432/DATABASE

# Optional separate connection fields for a local/VPS PostgreSQL instance.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=monitoring_system
# PGUSER=monitoring_runtime
# PGPASSWORD=CHANGE_ME
# PGSSL=false

# Optional comma-separated origins when the API is hosted separately.
# CORS_ORIGIN=https://your-domain.ir
